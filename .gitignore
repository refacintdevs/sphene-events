# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files — ignore real env files, allow example/template files
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
# Allow template files (explicitly un-ignore)
!.env.example
!.env.template

# Cloudinary local cache
.cloudinary/

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/

# Prisma (generated client only — keep schema and migrations)
src/generated/

# Logs
*.log

# Claude Code local state
.claude/

# IDE local state
.history/
*.code-workspace